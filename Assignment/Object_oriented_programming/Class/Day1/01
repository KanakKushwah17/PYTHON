'''Question 1: Employee Salary Management System
Scenario

A company wants to automate employee salary calculations. The HR department needs a system that calculates the gross salary of an employee by including allowances.

Requirements

Create a class named Employee with the following attributes:

employee_id
employee_name
basic_salary

Initialize the values using a constructor.

Calculations
HRA = 20% of Basic Salary
DA = 15% of Basic Salary
Gross Salary = Basic Salary + HRA + DA
Sample Input
Enter Employee ID : E101
Enter Employee Name : Rahul Sharma
Enter Basic Salary : 50000
Sample Output
------ Employee Salary Details ------
Employee ID      : E101
Employee Name    : Rahul Sharma
Basic Salary     : 50000.0
HRA              : 10000.0
DA               : 7500.0
Gross Salary     : 67500.0
'''
class Employee:
    def __init__(self,id,Name,basic_salary):
        self.id=id
        self.Name=Name
        self.basic_salary=basic_salary
    def HRA(self):
        self.hr=(self.basic_salary*20)/100
    def DA(self):
        self.da=(self.basic_salary*15)/100
    def salary(self):
        self.gross_salary=self.hr+self.da+self.basic_salary
       
basic_salary=float(input("Enter Salary : ")) 
ID=int(input("Enter employee ID "))
name=input("Enter Name ")

e1=Employee(id,name,basic_salary)
e1.HRA()
e1.DA()
e1.salary()


print("===========Employee Salary Detail==============")
print("Employee ID            :",ID)
print("Employee Name          :",name)
print("Employee Basic salary  :",basic_salary)
print("HRA                    :", e1.hr)
print("DA                     :", e1.da)
print("Gross Salary           :", e1.gross_salary)
